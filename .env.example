# Copie para .env na raiz do repositório e ajuste os dados da sua instalação.
# O VS Code carrega .env nas configurações de execução e nos testes.
DATABASE_URL=postgresql://localhost:5432/gestao_laboratorio
PGUSER=postgres
PGPASSWORD="preencha_a_senha_do_postgresql"
APP_PORT=8000
SESSION_HOURS=8
# Caminhos dos certificados confiáveis e intermediários para PDFs assinados.
# Separe vários caminhos por ponto e vírgula no Windows ou dois-pontos no Linux e macOS.
PDF_RAIZES_CONFIAVEIS=
PDF_CERTIFICADOS_INTERMEDIARIOS=
# Listas de revogação válidas da cadeia, no mesmo formato de caminhos.
PDF_LISTAS_REVOGACAO=

# Envio institucional opcional. Com SMTP_HOST vazio, os avisos ficam no painel e na fila.
SMTP_HOST=
SMTP_PORT=
SMTP_SEGURANCA=starttls
SMTP_REMETENTE=
SMTP_USUARIO=
SMTP_SENHA=
# Banco descartável separado para os testes de integração.
# TEST_DATABASE_URL=postgresql://localhost:5432/poodev_teste_local
